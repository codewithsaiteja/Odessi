# ODESSI.TFI — Frontend Environment Variables
# Copy to .env.local for local development

# Spring Boot backend URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Razorpay public key (Phase 5) — ONLY use rzp_test_ prefix in development
# NEVER expose your Key Secret here. Only the Key ID is safe to be public.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx

# WhatsApp Channel Concierge
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbEVJmGJJhzdJO2F4a2S

# Telegram Channel
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/odessitfi

# Facebook Page (optional — icon hidden if not set)
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/odessitfi

# Sentry — Frontend error monitoring (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=
