# ══════════════════════════════════════════════════════════════
# ODESSI.TFI — Backend Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/odessi
DB_USERNAME=odessi_user
DB_PASSWORD=your_secure_password_here

# ── Server ────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Frontend URL (CORS) ───────────────────────────────────────
# Comma-separated for multiple origins
FRONTEND_URL=http://localhost:3000

# ── Seed data ─────────────────────────────────────────────────
# Set to false in production to skip dev seed data
SEED_DATA_ENABLED=true

# ── JWT Authentication (Phase 4) ──────────────────────────────
# Generate a strong 256-bit+ secret key
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Cookie Security (Phase 4) ─────────────────────────────────
# Set SECURE=true in production (requires HTTPS)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# ── Security Policy ───────────────────────────────────────────
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── Future Phases ─────────────────────────────────────────────
# ── Razorpay (Phase 5) ────────────────────────────────────────
# Get your keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Checkout / Inventory Reservation (Phase 5) ────────────────
# Minutes before an unpaid reservation expires (default: 15)
RESERVATION_EXPIRATION_MINUTES=15
# Spring cron: how often to scan and clean up expired reservations (default: every 5 minutes)
SCHEDULED_CLEANUP_CRON=0 */5 * * * *

# ── Sentry Error Monitoring (odessi-backend) ─────────────────
# Set your backend Sentry DSN in your deployment environment (Render)
# Leave blank to disable Sentry in local development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=odessi-backend@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
