# ══════════════════════════════════════════════════════════════
# PRODUCTION BACKEND ENVIRONMENT VARIABLES
# Use these in your deployment platform (Railway, Render, etc.)
# ══════════════════════════════════════════════════════════════

# Database Configuration (PostgreSQL)
DB_URL=postgresql://username:password@host:5432/database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# CORS Configuration
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Configuration (Generate new secrets for production!)
JWT_SECRET=generate-a-very-long-secure-random-string-for-production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Security Settings
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Razorpay Configuration (Production keys)
RAZORPAY_KEY_ID=your_live_razorpay_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Email Configuration (for password reset, notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Rate Limiting
RATE_LIMIT_UNAUTH_MAX=5
RATE_LIMIT_UNAUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_AUTH_WINDOW=60

# Data Seeding (disable in production)
SEED_DATA_ENABLED=false

# ── Sentry Error Monitoring (odessi-backend) ─────────────────
# Set in Render: Environment -> SENTRY_DSN
# Get DSN from Sentry: Settings -> Projects -> odessi-backend -> Client Keys (DSN)
# Format: https://<key>@<org>.ingest.sentry.io/<project-id>
SENTRY_DSN=https://your-backend-sentry-dsn@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=odessi-backend@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.1