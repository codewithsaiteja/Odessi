# ══════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env.production and set your actual values
# ══════════════════════════════════════════════════════════════

# Frontend URL (Vercel deployment URL)
NEXT_PUBLIC_API_URL=https://your-backend-domain.railway.app

# Backend API endpoint
NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app

# Authentication
NEXTAUTH_URL=https://your-frontend.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-here

# Optional: Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# ── Sentry (Frontend error monitoring — Vercel) ──────────────────────────────
# DSN is public — safe to expose. Get from Sentry project settings.
# https://odessi.sentry.io/settings/projects/javascript-nextjs/keys/
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Auth token for source-map uploads (BUILD TIME ONLY — NEVER expose at runtime).
# Set in Vercel: Settings → Environment Variables → SENTRY_AUTH_TOKEN
# Generate at: https://odessi.sentry.io/settings/auth-tokens/
# Scope required: project:releases + org:read
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# Sentry org/project (must match next.config.ts withSentryConfig values)
SENTRY_ORG=odessi
SENTRY_PROJECT=javascript-nextjs